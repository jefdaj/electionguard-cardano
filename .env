# .env
NETWORK=preview

# Preview is served from the pre-release-preview network.
MITHRIL_AGGREGATOR_ENDPOINT=https://aggregator.pre-release-preview.api.mithril.network/aggregator

# Genesis verification key for the chosen network. For preview, fetch once with:
#   curl -fsSL https://raw.githubusercontent.com/input-output-hk/mithril/main/mithril-infra/configuration/pre-release-preview/genesis.vkey
# then paste the value here (it's a hex string, safe to commit for a testnet).
MITHRIL_GENESIS_VERIFICATION_KEY=5b3132372c37332c3132342c3136312c362c3133372c3133312c3231332c3230372c3131372c3139382c38352c3137362c3139392c3136322c3234312c36382c3132332c3131392c3134352c31332c3233322c3234332c34392c3232392c322c3234392c3230352c3230352c33392c3233352c34345d

# Optional: run the client as your host user so DB files aren't root-owned.
#   MITHRIL_UID=1000
#   MITHRIL_GID=1000

# This one is signed by IOG. You can skip it, but then you have to recompute the state from genesis.
# TODO estimate time to recompute without it
MITHRIL_ANCILLARY_VERIFICATION_KEY=5b3138392c3139322c3231362c3135302c3131342c3231362c3233372c3231302c34352c31382c32312c3139362c3230382c3234362c3134362c322c3235322c3234332c3235312c3139372c32382c3135372c3230342c3134352c33302c31342c3232382c3136382c3132392c38332c3133362c33365d
