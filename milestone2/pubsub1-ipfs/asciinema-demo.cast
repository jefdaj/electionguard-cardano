[162.461372, "o", "\u001b[39De': # now any json files i put in the pub1-publish dir should be replica\u001b[7mte\u001b(B\u001b[md via ipfs to the subscribe\u001b[2;53Hrs\u001b[1;145H"]
[162.637064, "o", "\u001b[71De': for n in {01..09}; do d=$(( (10#$n % 3) + 1 )); sudo mkdir -p /tmp/pubsub/pub1-publish/dir${d}; \u001b[2;53Hecho -n \"$(date) \"; echo \"{\\\"test $n\\\": \\\"dir${d}/file${n}.json -> publish dir -> IPFS on LAN -> subscriber dirs\\\"}\" | su\u001b[3;53Hdo \u001b[7mtee\u001b(B\u001b[m /tmp/pubsub/pub1-publish/dir${d}/test${n}.json; sleep 2; done \u001b[56G"]
[163.435806, "o", "\u001b[38;94H4.04\u001b[7C4.37\u001b[29C95\u001b[6C.17MB\u001b[39;94H5.96\u001b[9C9\u001b[21C7\u001b[8C82MB / 3.03\u001b[40;94H4.29\u001b[7C5.02\u001b[29C54\u001b[7C2MB \u001b[42;96H10\u001b[43;97H5\u001b[3;56H"]
[163.797229, "o", "\u001b[1;53H$ for n in {01..09}; do d=$(( (10#$n % 3) + 1 )); sudo mkdir -p /tmp/pubsub/pub1-publish/dir${d}; echo -n \"$(date) \"; ech\u001b[2;53Ho \"{\\\"test $n\\\": \\\"dir${d}/file${n}.json -> publish dir -> IPFS on LAN -> subscriber dirs\\\"}\" | sudo tee /tmp/pubsub/pub1\u001b[3;53H-\u001b[?25l\b-publish/dir${d}/test${n}.json; sleep 2; done \u001b[K\u001b[2;154H\u001b[?12l\u001b[?25h\u001b[4;53H"]
