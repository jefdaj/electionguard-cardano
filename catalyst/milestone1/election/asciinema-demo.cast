[47.609306, "o", "\u001b[?25l\u001b[1d\u001b[K\n### publish_joint_key ###\u001b[K\u001b[3;82H\u001b[K\ndocker exec election-admin1-1 poetry run /scripts/admin.py publish-joint-key --public-dir /data/public\u001b[K\u001b[5;82H\u001b[K\n\u001b[K\n### build_election ###\u001b[K\u001b[8;82H\u001b[K\ndocker exec election-admin1-1 poetry run /scripts/admin.py build-election --public-dir /data/public\u001b[K\u001b[10;82H\u001b[K\n\u001b[K\n### add_devices ###\u001b[K\u001b[13;82H\u001b[K\ndocker exec election-device1-1 poetry run /scripts/device.py add-device --public-dir /data/public --device-num\u001b[15;82Hber 1\u001b[K\u001b[16;82H\u001b[K\ndocker exec election-device2-1 poetry run /scripts/device.py add-device --public-dir /data/public --device-num\u001b[18;82Hber 2\u001b[K\u001b[19;82H\u001b[K\ndocker exec election-device3-1 poetry run /scripts/device.py add-device --public-dir /data/public --device-num\u001b[21;82Hber 3\u001b[K\u001b[22;82H\u001b[K\ndocker exec election-device4-1 poetry run /scripts/device.py add-device --public-dir /data/public --device-num\u001b[24;82Hber 4\u001b[K\u001b[25;82H\u001b[K\n\u001b[K\n### vote_all ###\u001b[K\u001b[28;82H\u001b[K\ndocker exec election-device1-1 poetry run /scripts/device.py vote --public-dir /data/public --private-dir /dat\u001b[30;82Ha/private --device-number 1 --candidate Yes --spoil True\u001b[K\u001b[31;82H\u001b[K\ndocker exec election-device2-1 poetry run /scripts/device.py vote --public-dir /data/public --private-dir /dat\u001b[33;82Ha/private --device-number 2 --candidate Yes --spoil False\u001b[K\u001b[34;82H\u001b[K\ndocker exec election-device3-1 poetry run /scripts/device.py vote --public-dir /data/public --private-dir /dat\u001b[36;82Ha/private --device-number 3 --candidate Yes --spoil False\u001b[K\u001b[37;82H\u001b[K\ndocker exec election-device4-1 poetry run /scripts/device.py vote --public-dir /data/public --private-dir /dat\u001b[39;82Ha/private --device-number 4 --candidate Yes --spoil False\u001b[K