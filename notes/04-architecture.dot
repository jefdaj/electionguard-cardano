digraph docker_compose_architecture {
	rankdir=LR
	cardano  [label="0. Cardano\nnode"]
	ipfs     [label="1. IPFS"]
	egsync   [label="2. egsync"]
	admin    [label="3. admin"]
	guardian [label="4. guardian"]
	mediator [label="5. mediator"]
	voter    [label="6. voter"]
	verifier [label="7. verifier"]
	observer  [label="8. observer"]
	cardano  -> egsync   [dir=both]
	ipfs     -> egsync   [dir=both]
	egsync   -> admin    [dir=both]
	egsync   -> guardian [dir=both]
	egsync   -> mediator [dir=both]
	egsync   -> verifier [dir=both]
	mediator -> voter    [dir=both]
	egsync   -> observer [dir=both]
}
